# CodeOracle environment variables.
# Copy to .env (gitignored). Never commit a real .env.

CODEORACLE_ENVIRONMENT=dev
CODEORACLE_LOG_LEVEL=INFO

# Database and Valkey.
CODEORACLE_DB__HOST=localhost
CODEORACLE_DB__PORT=5432
CODEORACLE_DB__USER=codeoracle
CODEORACLE_DB__PASSWORD=<set_me>
CODEORACLE_DB__DATABASE=codeoracle
CODEORACLE_DB__POOL_SIZE=5
CODEORACLE_DB__MAX_OVERFLOW=10
CODEORACLE_DB__POOL_TIMEOUT=30
CODEORACLE_VALKEY__URL=redis://localhost:6379/0
CODEORACLE_VALKEY__POOL_MIN=1
CODEORACLE_VALKEY__POOL_MAX=10
CODEORACLE_VALKEY__BLOCK_MS_DEFAULT=5000
CODEORACLE_VALKEY__MAX_IN_FLIGHT_PER_CONSUMER=10
CODEORACLE_VALKEY__STREAM_MAXLEN=1000000

# LLM provider. Select one with CODEORACLE_LLM_PROVIDER.
CODEORACLE_LLM_PROVIDER=openai
CODEORACLE_LLM_OPENAI__API_KEY=<set_me>
CODEORACLE_LLM_OPENAI__MODEL=gpt-4o-mini
CODEORACLE_LLM_ANTHROPIC__API_KEY=<set_me>
CODEORACLE_LLM_ANTHROPIC__MODEL=claude-opus-4-8
CODEORACLE_LLM_VLLM__BASE_URL=http://localhost:8000/v1
CODEORACLE_LLM_VLLM__MODEL=Qwen/Qwen2.5-32B-Instruct
CODEORACLE_LLM_VLLM__API_KEY=EMPTY
CODEORACLE_LLM_OLLAMA__BASE_URL=http://localhost:11434
CODEORACLE_LLM_OLLAMA__MODEL=qwen2.5:32b
CODEORACLE_LLM_MOCK__SCRIPTS_DIR=tests/fixtures/llm_scripts
CODEORACLE_LLM_MOCK__STRICT=true

# Embeddings.
CODEORACLE_EMBEDDING__MODEL=text-embedding-3-small
CODEORACLE_EMBEDDING__DIM=1536
CODEORACLE_EMBEDDING__KIND=openai
CODEORACLE_EMBEDDING__BASE_URL=https://api.openai.com
CODEORACLE_EMBEDDING__API_KEY=<set_me>

# Process bind/outbound settings.
CODEORACLE_API__HOST=0.0.0.0
CODEORACLE_API__PORT=8080
CODEORACLE_API__AGENT_BASE_URL=http://localhost:8081
CODEORACLE_API__AGENT_REQUEST_TIMEOUT_SECONDS=35
CODEORACLE_API__LOCK_ACQUISITION_TIMEOUT_SECONDS=5
CODEORACLE_AGENT__HOST=0.0.0.0
CODEORACLE_AGENT__PORT=8081
CODEORACLE_AGENT__SHARED_TOKEN=
CODEORACLE_MCP__HOST=0.0.0.0
CODEORACLE_MCP__PORT=8082

# Indexing, Sourcebot, and traces.
CODEORACLE_INDEXING__REPO_ROOT=.
CODEORACLE_INDEXING__EXTRACTOR_KINDS=["joern","scip","opengrep","embed"]
CODEORACLE_SOURCEBOT__BASE_URL=http://localhost:3000
CODEORACLE_SOURCEBOT__API_KEY=<set_me>
CODEORACLE_SOURCEBOT__TIMEOUT_SECONDS=5
CODEORACLE_SOURCEBOT__DEFAULT_REPO=local-self
CODEORACLE_TRACES__TEMPO_URL=http://localhost:3200
CODEORACLE_TRACES__TEMPO_TIMEOUT_SECONDS=5
CODEORACLE_TRACES__TICK_INTERVAL_SECONDS=30
CODEORACLE_TRACES__SEARCH_LIMIT=50
CODEORACLE_TRACES__MAX_BACKOFF_SECONDS=60
CODEORACLE_TRACES__CURSOR_OVERLAP_SECONDS=10

# OpenTelemetry.
CODEORACLE_OTEL_ENDPOINT=http://localhost:4317
CODEORACLE_OTEL_ENABLED=true
CODEORACLE_OTEL_SERVICE_NAME=codeoracle
CODEORACLE_OTEL_SERVICE_VERSION=0.1.0

# Docker entrypoint dispatcher.
CODEORACLE_VARIANT=cli
