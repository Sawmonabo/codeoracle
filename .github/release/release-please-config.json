{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "codeoracle",
      "release-type": "python",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.tool.commitizen.version"
        },
        {
          "type": "generic",
          "path": "src/codeoracle/core/version.py"
        }
      ]
    }
  }
}
